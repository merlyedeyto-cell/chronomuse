# Enable directory listing for uploads (optional, for debugging)
Options +Indexes

# Ensure correct MIME types for audio files
<IfModule mod_mime.c>
    AddType audio/mpeg .mp3
    AddType audio/wav .wav
    AddType audio/ogg .ogg
    AddType audio/mp4 .m4a
    AddType audio/aac .aac
</IfModule>

# Enable CORS for audio files (important for InfinityFree)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    
    # Enable caching for audio files
    <FilesMatch "\.(mp3|wav|ogg|m4a|aac)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>

# Prevent PHP execution in uploads folder (security)
<FilesMatch "\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
